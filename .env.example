# =============================================================================
# BANTAYOG — Root Environment Variables (.env.example)
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================================

# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth / JWT ----
JWT_SIGNING_SECRET=your-jwt-signing-secret-min-32-chars

# ---- CORS ----
# Comma-separated web origins. Include https://localhost for the Capacitor APK.
CORS_ORIGIN=http://localhost:3000,https://localhost

# ---- Upstash (rate-limit + cache) ----
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---- Vercel Cron ----
CRON_SECRET=your-cron-secret

# ---- Gemini (@google/genai) ----
GEMINI_API_KEY=your-gemini-api-key

# ---- Stellar testnet configuration ----
# Horizon endpoint and network passphrase used by scripts/bootstrap-stellar.ts.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PHPC_ASSET_CODE=PHPC

# Testnet-only Stellar secrets. The bootstrap script can generate these values
# and friendbot the accounts. Never commit real secrets.
PHPC_ISSUER_PUBLIC_KEY=
PHPC_ISSUER_SECRET=
PHPC_DISTRIBUTION_SECRET=
STELLAR_SPONSOR_SECRET=
